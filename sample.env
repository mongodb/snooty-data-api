# Connection string to be used for MongoDB to connect to Atlas
ATLAS_URI=mongodb://localhost:27017
# The user who performed the build or uploaded build data through the persistence
# module. By default, this should be docsworker-xlarge. Otherwise, it should be
# your local machine's user (whoami)
BUILDER_USER=docsworker-xlarge
# The port number used for the app server
PORT=3000
# snooty_* db to connect to for build artifacts
SNOOTY_DB_NAME=snooty_dev
SNOOTY_PROD_DB_NAME=snooty_dev
# Selects which host/prefix to build fullUrl from. Must be dotcomprd or
# dotcomstg; any other value is rejected at startup.
SNOOTY_ENV=dotcomprd
# Docsets API used by /projects for versioning data. Point at the prod feed for
# local development; staging is https://preprd--docs-on-nextjs.netlify.app/api/docsets/
DOCSETS_API_URL=https://docs-on-nextjs.netlify.app/api/docsets/
# Optional. How long a fetched docsets response is cached, in ms. Defaults to 600000 (10 min).
# DOCSETS_CACHE_TTL_MS=600000
# Optional. Timeout for the docsets API request, in ms. Defaults to 10000.
# DOCSETS_FETCH_TIMEOUT_MS=10000
